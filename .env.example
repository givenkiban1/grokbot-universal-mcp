# Copy to .env (or run ./scripts/init-env.sh, which fills in the secrets). Never commit .env.

# The public address of this server, as people and Claude reach it.
PUBLIC_URL=https://grokbot.example.com

# openssl rand -base64 32 — encrypts bot keys and 2FA secrets. BACK IT UP separately from the database:
# a database backup is useless without it, and anyone with both can read the keys.
ENCRYPTION_KEY=

# openssl rand -hex 24
POSTGRES_PASSWORD=

# From Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install with Docker (the long token).
CLOUDFLARE_TUNNEL_TOKEN=

# Real client IPs from Cloudflare's CF-Connecting-IP header (for rate limits and the activity log).
BEHIND_CLOUDFLARE=true

# invite (default): sign-up needs an invite link. open: anyone who can reach the server can sign up.
SIGNUP=invite

# Optional: only allow bot webhooks to these hosts (comma-separated, *.example.com allowed). Empty = any public HTTPS host.
WEBHOOK_HOSTS=api2.cursor.sh

# Optional: OAuth redirect hosts for Claude connectors. The default covers Claude's apps and Claude Code.
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com,localhost,127.0.0.1
